# Gen-Z Storefront — Frontend Environment Configuration
# Copy this file to .env and adjust for your local backend.
# Never commit .env — it is already listed in .gitignore.

# Base URL of the genz-backend API, INCLUDING the /api/v1 prefix
# (matches the backend's API_PREFIX, default /api/v1 — see
# genz-backend/genz-backend/.env.example and src/app.js).
#
# Production (Vercel): set VITE_API_URL as an environment variable in the
# Vercel project's own dashboard (Project Settings → Environment Variables)
# — never put the production value in this file. The deployed backend is
# currently at https://genz-backend-63f3.onrender.com/api/v1.
VITE_API_URL=http://localhost:4000/api/v1

# Optional. Public base URL for Cloudflare R2 product images, if the
# backend's R2 bucket has one configured (R2_PUBLIC_BASE_URL in the
# backend's own .env). product_images.image_reference is an R2 object key,
# not a full URL — src/utils/format.js's resolveImageUrl() prefixes this
# base to build a real <img> src. Leave unset to always show the
# placeholder monogram instead (never a broken image).
# VITE_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
