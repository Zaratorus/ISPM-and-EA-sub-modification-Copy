# ============================================================
# Gen-Z Digital Storefront — Backend Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=genz_app_user
DB_PASSWORD=changeme
DB_NAME=genz_digital_storefront
DB_CONNECTION_LIMIT=10

# --- Auth: Customer JWT ---
CUSTOMER_JWT_SECRET=change_this_to_a_long_random_string
CUSTOMER_JWT_EXPIRES_IN=7d

# --- Customer login rate limiting (not secrets; optional, defaults shown) ---
# Failed logins allowed per IP + contact info within the window before the
# login endpoint answers 429 with a Retry-After header.
CUSTOMER_LOGIN_RATE_LIMIT_WINDOW_MS=900000
CUSTOMER_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# --- Auth: Owner/Admin Access Key ---
# OPEN (Backend/API Architecture Design V1.0, Section 15 item 7):
# exact hashing algorithm not yet decided by the team/supervisor.
# ADMIN_ACCESS_KEY_RAW is used only by the one-time setup script
# (scripts/set-admin-access-key.js) to seed admin_access_key.access_key_hash.
ADMIN_ACCESS_KEY_RAW=changeme_set_once_then_remove_from_env
ADMIN_SESSION_JWT_SECRET=change_this_to_a_different_long_random_string
ADMIN_SESSION_EXPIRES_IN=12h
ADMIN_ACCESS_KEY_RATE_LIMIT_WINDOW_MS=900000
ADMIN_ACCESS_KEY_RATE_LIMIT_MAX_ATTEMPTS=5

# --- Courier links (Delivery Person, no account) ---
# Signs each delivery's courier link (HMAC-SHA256). Keep it secret, at least
# 32 characters, and different from the JWT secrets above.
COURIER_LINK_SECRET=change_this_to_another_long_random_string

# --- Mail (customer password-reset codes) ---
# console = development only: the code is printed in the server console and
# no email is sent (refused unless NODE_ENV=development). smtp = send by SMTP.
MAIL_TRANSPORT=console
# Required when MAIL_TRANSPORT=smtp. Placeholders only — never commit real
# values (e.g. Gmail: smtp.gmail.com, 465, true, your address, an app password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change_this_smtp_username
SMTP_PASS=change_this_smtp_password
MAIL_FROM="Gen-Z Store <no-reply@example.com>"

# --- Auth: Staff ---
# OPEN (Backend/API Architecture Design V1.0, Section 15 item 1):
# Staff authentication entry mechanism is not yet designed.
# No STAFF_* variables are defined here until that decision is made.

# --- Cloudflare R2 (product images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=genz-product-images
R2_PUBLIC_BASE_URL=

# --- WhatsApp checkout ---
# OPEN (Backend/API Architecture Design V1.0, Section 15 item 3):
# exact integration mechanism (simple wa.me link vs. formal Business API)
# is not yet decided. STORE_WHATSAPP_NUMBER is used for the simple-link path.
STORE_WHATSAPP_NUMBER=
